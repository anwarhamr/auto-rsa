[Unit]
Description=RSA Auto Trader Robinhood egress gateway
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/etc/rsa-auto-trader/robinhood-deploy.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rsa-auto-trader/robinhood/current
ExecStart=/usr/bin/docker compose --env-file /etc/rsa-auto-trader/robinhood-deploy.env -f docker-compose.robinhood.yml up -d --no-build --remove-orphans robinhood-egress
ExecStop=/usr/bin/docker compose --env-file /etc/rsa-auto-trader/robinhood-deploy.env -f docker-compose.robinhood.yml down
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
