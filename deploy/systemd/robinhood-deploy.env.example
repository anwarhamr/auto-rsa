# Install as /etc/rsa-auto-trader/robinhood-deploy.env with mode 0600.
# Use registry digest references in production. A local image ID (sha256:...)
# is acceptable for an offline qualification build.
COMPOSE_PROJECT_NAME=rsa-auto-trader-robinhood
RSA_IMAGE=registry.example/auto-rsa@sha256:<application-image-digest>
RSA_EGRESS_IMAGE=registry.example/rsa-robinhood-egress@sha256:<gateway-image-digest>
RSA_ROBINHOOD_ACCOUNTS_FILE_HOST=/etc/rsa-auto-trader/robinhood-accounts.json
RSA_ROBINHOOD_RUNTIME_DIR=/run/rsa-auto-trader/robinhood
RSA_ROBINHOOD_SESSION_TTL_SECONDS=3600
TRADING_DISABLED=true
DANGER_MODE=false
