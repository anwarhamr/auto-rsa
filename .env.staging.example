# Install as /etc/rsa-auto-trader/staging.env with mode 0600. Never commit it.

# Leave both values empty for the initial CLI-only staging phase. A later
# Discord phase requires a dedicated staging-only bot token and channel.
DISCORD_TOKEN=""
DISCORD_CHANNEL=""

# Optional non-secret command names. Dedicated names avoid collisions with a
# production bot if both are visible in the same Discord server.
DISCORD_PREFIX="!"
DISCORD_RSA_COMMAND="rsa-staging"

# These are repeated in docker-compose.staging.yml and must remain fail-closed.
TRADING_DISABLED="true"
DANGER_MODE="false"
HEADLESS="true"
SORT_BROKERS="true"

# Chase remains unconfigured in the CLI-only baseline. Legacy environment
# credentials and durable browser state stay explicitly disabled.
RSA_BROKER_CREDENTIALS_FILE=""
RSA_ALLOW_LEGACY_ENV_CREDENTIALS="false"
RSA_CHASE_ALLOW_DURABLE_PROFILE="false"
RSA_CHASE_PROFILE_DIR=""

# Robinhood remains disabled in the baseline. A later one-shot trial must mount
# the protected account file and tmpfs session/password paths outside the image.
RSA_ROBINHOOD_ACCOUNTS_FILE=""
RSA_ROBINHOOD_PASSWORD_FILE=""
RSA_ROBINHOOD_SESSION_DIR=""
RSA_ROBINHOOD_SESSION_TTL_SECONDS="3600"
