# Copy to .env.staging on the staging host. Never commit .env.staging.

# Secret: token for a dedicated staging-only Discord bot.
DISCORD_TOKEN=""

# Non-secret: numeric ID of a dedicated staging-only Discord channel.
DISCORD_CHANNEL=""

# Optional non-secret command names. Dedicated names avoid collisions with a
# production bot if both are visible in the same Discord server.
DISCORD_PREFIX="!"
DISCORD_RSA_COMMAND="rsa-staging"

# These are repeated in docker-compose.staging.yml and must remain fail-closed.
TRADING_DISABLED="true"
DANGER_MODE="false"
HEADLESS="true"
SORT_BROKERS="true"
